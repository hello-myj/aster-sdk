{
  "schema": 1,
  "id": "lckfb-s3",
  "product": "aster",
  "abi": "3.3.0",
  "system": "zephyr",
  "cpu": "xtensa",
  "aot_target": "xtensa",
  "capabilities": [
    "display",
    "touch",
    "keyboard",
    "camera",
    "audio-in",
    "audio-out",
    "wifi",
    "accelerometer",
    "gyroscope",
    "filesystem",
    "storage.app",
    "rtc",
    "psram",
    "framebuffer"
  ],
  "display": {
    "width": 320,
    "height": 240,
    "format": "rgb565",
    "modes": [
      "landscape",
      "portrait",
      "headless"
    ],
    "runtime_switch": true
  },
  "memory": {
    "max_linear": 2097152
  },
  "deployment": {
    "transport": "serial",
    "console": "/dev/ttyUSB0",
    "data_glob": "/dev/ttyACM*",
    "package_dir": "/SD:"
  },
  "status": "build-supported",
  "name": "\u7acb\u521b\u5f00\u53d1\u677f ESP32-S3 \u5b9e\u6218\u6d3e"
}
