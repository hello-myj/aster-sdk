{
  "schema": 1,
  "id": "waveshare-35b",
  "product": "aster",
  "abi": "3.7.0",
  "system": "zephyr",
  "cpu": "xtensa",
  "aot_target": "xtensa",
  "capabilities": [
    "display",
    "touch",
    "keyboard",
    "audio-in",
    "audio-out",
    "wifi",
    "filesystem",
    "storage.app",
    "rtc",
    "psram",
    "framebuffer"
  ],
  "display": {
    "width": 320,
    "height": 480,
    "format": "rgb565",
    "modes": [
      "landscape",
      "portrait",
      "headless"
    ],
    "runtime_switch": true
  },
  "memory": {
    "max_linear": 4194304
  },
  "deployment": {
    "transport": "serial",
    "console": "/dev/ttyUSB0",
    "data_glob": "/dev/ttyACM*",
    "package_dir": "/SD:"
  },
  "status": "experimental",
  "name": "\u5fae\u96ea ESP32-S3-Touch-LCD-3.5B"
}
