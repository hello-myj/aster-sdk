{
  "schema": 1,
  "id": "xtensa",
  "product": "aster",
  "abi": "3.9.0",
  "system": "zephyr",
  "cpu": "xtensa",
  "aot_target": "xtensa",
  "capabilities": [
    "display",
    "touch",
    "mouse",
    "keyboard",
    "camera",
    "audio-in",
    "audio-out",
    "wifi",
    "bluetooth",
    "accelerometer",
    "gyroscope",
    "filesystem",
    "storage.app",
    "rtc",
    "psram",
    "framebuffer",
    "network",
    "http",
    "tls"
  ],
  "deployment": {
    "transport": "serial",
    "console": "/dev/ttyUSB0",
    "data_glob": "/dev/ttyACM*",
    "package_dir": "/SD:"
  },
  "status": "build-supported",
  "name": "Xtensa"
}
