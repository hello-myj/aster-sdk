{
  "schema": 1,
  "id": "riscv",
  "product": "aster",
  "abi": "4.6.0",
  "system": "esp-idf",
  "cpu": "riscv32",
  "aot_target": "riscv32",
  "capabilities": [
    "display",
    "touch",
    "mouse",
    "keyboard",
    "camera",
    "audio-in",
    "audio-out",
    "wifi",
    "bluetooth",
    "accelerometer",
    "gyroscope",
    "filesystem",
    "rtc",
    "psram",
    "framebuffer",
    "network",
    "http",
    "tls",
    "mqtt",
    "audio-stream",
    "websocket",
    "audio-effects",
    "audio-effects-memory",
    "media-player",
    "storage.app"
  ],
  "deployment": {
    "transport": "serial",
    "console": "/dev/ttyUSB0",
    "data_glob": "/dev/ttyACM*",
    "package_dir": "/SD:"
  },
  "status": "hardware-verified",
  "name": "Riscv",
  "aot_profile": "rv32-ilp32f-interruptible"
}
